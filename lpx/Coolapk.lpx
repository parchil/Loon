[Rewrite]
^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch reject-dict


[Script]
http-response ^https:\/\/api\.coolapk\.com\/v6\/main\/init script-path = https://raw.githubusercontent.com/parchil/Loon/refs/heads/main/js/coolapk.js, requires-body = true, tag = [酷安]移除广告
http-response ^https:\/\/api\.coolapk\.com\/v6\/main\/indexV8 script-path = https://raw.githubusercontent.com/parchil/Loon/refs/heads/main/js/coolapk.js, requires-body = true, tag = [酷安]移除广告
http-response ^https:\/\/api\.coolapk\.com\/v6\/page\/dataList script-path = https://raw.githubusercontent.com/parchil/Loon/refs/heads/main/js/coolapk.js, requires-body = true, tag = [酷安]移除广告
http-response ^https:\/\/api\.coolapk\.com\/v6\/account\/loadConfig\?key=my_page_card_config script-path = https://raw.githubusercontent.com/parchil/Loon/refs/heads/main/js/coolapk.js, requires-body = true, tag = [酷安]移除广告

[MitM]
hostname=api.coolapk.com